{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mahalle-si",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mahalle-si-emails",
      "database_id": "REPLACE_AFTER_CREATE"
    }
  ],
  "routes": [
    { "pattern": "mahalle.si", "custom_domain": true }
  ]
}
