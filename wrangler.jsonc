{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mahalle-si",
	"main": "src/worker.js",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mahalle-si-emails",
			"database_id": "77fd2b7a-5601-44ea-b97a-056feaa454c9"
		}
	],
	"routes": [
		{
			"pattern": "mahalle.si",
			"custom_domain": true
		}
	]
}